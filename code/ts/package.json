{
  "name": "ts",
  "private": true,
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "bun run lint && bun run fmt:check && bun run test",
    "gen:question-pydantic": "bun run scripts/generate-question-pydantic.ts",
    "gen:api-client": "bunx @hey-api/openapi-ts",
    "gen:api-client:watch": "bunx chokidar-cli \"../python/src/thesis/ts_api/ts_api.py\" -c \"bun run gen:api-client\"",
    "scrape:1-exams": "bun run scripts/shititong/collect-exam-links.ts",
    "scrape:2-filter": "bun run scripts/shititong/filter-exams.ts",
    "scrape:3-chapters": "bun run scripts/shititong/collect-chapter-links.ts",
    "scrape:4-questions": "bun run scripts/shititong/extract-questions.ts",
    "scrape:fix-tf": "bun run scripts/shititong/fix-true-false.ts",
    "scrape:5-merge": "bun run scripts/shititong/merge-questions.ts",
    "scrape:6-split": "bun run scripts/shititong/split-by-language.ts"
  },
